require "./spec_helper"

# Decoder parity against the vendored Go decoder.
#
# `spec/fixtures/decode_golden.tsv` is generated by `make decode-golden`, which
# runs the decoder in `vendor/ultraviolet` over the inputs in
# `spec/fixtures/decode_inputs.txt`. The expectations therefore come from
# upstream, not from this port: a change here that upstream did not make fails.
#
# The inputs are the mouse families (press, release, motion with and without a
# held button, wheel, legacy X10) and the terminal size reports, because those
# are what mouse tracking depends on end to end: pixel coordinates are only
# meaningful once a `CSI 4 ; h ; w t` report has told the app its pixel size.
module DecodeGoldenHelper
  FIXTURES = File.expand_path("fixtures", __DIR__)

  def self.golden : Array({Bytes, Array(String)})
    File.read_lines(File.join(FIXTURES, "decode_golden.tsv")).reject(&.empty?).map do |line|
      hex, signatures = line.split('\t')
      {hex.hexbytes, signatures.split(' ')}
    end
  end

  def self.signature(event) : String
    case event
    when Ultraviolet::MouseClickEvent
      mouse_signature("click", event.mouse)
    when Ultraviolet::MouseReleaseEvent
      mouse_signature("release", event.mouse)
    when Ultraviolet::MouseWheelEvent
      mouse_signature("wheel", event.mouse)
    when Ultraviolet::MouseMotionEvent
      mouse_signature("motion", event.mouse)
    when Ultraviolet::PixelSizeEvent
      "pixel:#{event.width},#{event.height}"
    when Ultraviolet::CellSizeEvent
      "cell:#{event.width},#{event.height}"
    when Ultraviolet::WindowSizeEvent
      "size:#{event.width},#{event.height}"
    when Ultraviolet::WindowOpEvent
      "winop:#{event.op}:[#{event.args.join(',')}]"
    when Ultraviolet::UnknownCsiEvent
      "unknowncsi"
    else
      "other:#{event.class}"
    end
  end

  private def self.mouse_signature(kind : String, mouse : Ultraviolet::Mouse) : String
    "#{kind}:#{mouse.x},#{mouse.y},#{mouse.button.value},#{mouse.mod}"
  end

  def self.decode_signatures(input : Bytes) : Array(String)
    decoder = Ultraviolet::EventDecoder.new
    signatures = [] of String
    buffer = input
    until buffer.empty?
      n, event = decoder.decode(buffer)
      if n == 0 || event.nil?
        signatures << "unparsed"
        break
      end
      case event
      when Array
        event.each { |item| signatures << signature(item) }
      else
        signatures << signature(event)
      end
      buffer = buffer[n..]
    end
    signatures
  end
end

describe "Decoder golden (vendored oracle)" do
  it "matches the vendored Go decoder for every curated input" do
    golden = DecodeGoldenHelper.golden
    golden.size.should be > 0

    golden.each do |input, expected|
      actual = DecodeGoldenHelper.decode_signatures(input)
      actual.should eq(expected), "input 0x#{input.hexstring}"
    end
  end

  it "covers mouse motion and the pixel size report tracking needs" do
    signatures = DecodeGoldenHelper.golden.flat_map(&.[1])

    signatures.any?(&.starts_with?("motion:")).should be_true
    signatures.any?(&.starts_with?("pixel:")).should be_true
  end
end
