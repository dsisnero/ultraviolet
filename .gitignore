/docs/*
!/docs/*.md
/lib/*
!/lib/ansi/
!/lib/ansi/**
!/lib/colorful/
!/lib/colorful/**
!/lib/mosaic/
!/lib/mosaic/**
/.shards/
.crystal-cache/
temp/
tmp/
log/
node_modules/
*.dwarf

# Examples and the Go references write log files
*.log

# Binaries from `make build-examples` land next to their sources
/examples/*
!/examples/*.cr

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock
/lib
/crystal

# macOS metadata files
.DS_Store
._*
.Spotlight-V100
.Trashes

# The parity skill's optional tree-sitter backend installs its parser into the
# repo root when it is tried; the ledger here runs with PORT_PARSER=regex, so
# these are tooling leftovers rather than project files.
/package.json
/package-lock.json
